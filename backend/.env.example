PORT=5001
MONGODB_URI=mongodb://localhost:27017/nuocleo-crm
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# Email Configuration (Gmail — BẮT BUỘC App Password sau khi bật 2FA)
# https://myaccount.google.com/apppasswords → copy 16 ký tự liền (không dấu cách)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=abcdefghijklmnop
EMAIL_FROM=your_email@gmail.com
# Chỉ dùng khi test — gửi mọi email vào TEST_EMAIL_TO thay vì email khách (bật EMAIL_TEST_REDIRECT=true)
# TEST_EMAIL_TO=your_email@gmail.com
# EMAIL_TEST_REDIRECT=false
SUPPORT_EMAIL=nuocleosaigon@gmail.com
BRAND_NAME=HDTLabx
STORE_NAME=HDTLabx

# Web công khai (Hostinger) — trùng domain
FRONTEND_URL=https://hdtlabx.com
# Máy local: FRONTEND_URL=http://localhost:3000

# Google Drive — album ảnh scan (tránh giới hạn dung lượng Gmail)
# 1) Google Cloud: bật Drive API, tạo Service Account, tải JSON key
# 2) Đặt file vào backend/credentials.json (hoặc đường dẫn tùy chỉnh bên dưới)
# 3) Tạo folder Lab_Scan_Photos trên Drive, Share quyền Editor cho client_email trong JSON
# 4) Copy ID thư mục từ URL Drive (phần sau /folders/)
GOOGLE_DRIVE_PARENT_FOLDER_ID=
# GOOGLE_DRIVE_CREDENTIALS_PATH=credentials.json
# GOOGLE_DRIVE_REQUIRED=true   # bắt buộc Drive; không fallback gallery web khi lỗi

# Environment
NODE_ENV=production
# Máy local: NODE_ENV=development
# USE_MEMORY_DB=true   # DB tạm khi không cài MongoDB; mỗi lần start server tự tạo lại 14 khách mẫu
# AUTO_SEED=true       # Tự thêm inventory / retail mẫu khi start

# Chủ hệ thống (1 owner + tối đa 1 staff)
OWNER_EMAIL=crotoart@gmail.com
OWNER_PASSWORD=123456
OWNER_NAME=Crotoart Admin
# RESET_OWNER_PASSWORD=true  # bật một lần để reset mật khẩu owner theo OWNER_PASSWORD

# AI nhập kho bán lẻ (tùy chọn — không có thì dùng mô phỏng)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
