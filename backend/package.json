{
  "name": "crm-backend",
  "version": "1.0.0",
  "description": "CRM — API (hdtlabx.com)",
  "main": "server.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "node server.js",
    "build:web": "npm --prefix ../frontend install --include=dev && npm --prefix ../frontend run build && rm -rf public && cp -R ../frontend/dist public",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "test:email": "node scripts/test-email.js",
    "test:invoice": "node scripts/send-invoice-demo.js",
    "test:send-mail": "node test_send_mail.js",
    "preview:receipt": "node scripts/preview-receipt-email.js",
    "test:drive": "node scripts/test-drive.js",
    "test": "node --test test/*.test.js",
    "audit:runtime": "npm audit --omit=dev --audit-level=moderate"
  },
  "keywords": [
    "crm",
    "photo",
    "lab",
    "film",
    "processing"
  ],
  "author": "Copilot",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.22.3",
    "express-validator": "^7.0.0",
    "file-type": "^21.3.2",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongodb-memory-server": "^10.1.4",
    "mongoose": "^7.0.0",
    "multer": "2.5.0",
    "nodemailer": "10.1.4",
    "otpauth": "9.5.2",
    "qrcode": "1.5.4"
  }
}
