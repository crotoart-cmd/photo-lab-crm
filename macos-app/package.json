{
  "name": "hdtlabx-macos",
  "version": "1.0.0",
  "description": "HDTLabx — bản cài đặt macOS (tách khỏi dev server)",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev": "node scripts/dev.js",
    "build:frontend": "node scripts/build-frontend.js",
    "stage": "node scripts/stage.js",
    "pack": "npm run build:frontend && npm run stage && electron-builder --mac dmg",
    "pack:dir": "npm run build:frontend && npm run stage && electron-builder --mac dir"
  },
  "build": {
    "appId": "com.hdtlabx.crm",
    "productName": "HDTLabx",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "staging/backend",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "staging/frontend",
        "to": "frontend",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": ["dmg"],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "HDTLabx"
    }
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "express": "^4.22.3",
    "http-proxy": "^1.18.1"
  }
}
